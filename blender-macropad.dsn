      (pins SW3-1 D3-2)
    )
    (class kicad_default /COL0 /COL1 /COL2 /COL3 /ENC_A /ENC_B /ENC_SW /GND
      /OLED_CLK /OLED_CS /OLED_DC /OLED_MOSI /OLED_RST /RAW /ROW0 /ROW1 /ROW2
      /RST /VCC "Net-(D1-A)" "Net-(D10-A)" "Net-(D11-A)" "Net-(D12-A)" "Net-(D2-A)"
      "Net-(D3-A)" "Net-(D4-A)" "Net-(D5-A)" "Net-(D6-A)" "Net-(D7-A)" "Net-(D8-A)"
      "Net-(D9-A)" "unconnected-(J1-Pin_13-Pad13)" "unconnected-(J1-Pin_14-Pad14)"
      "unconnected-(J1-Pin_15-Pad15)" "unconnected-(J1-Pin_16-Pad16)"
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
